 <Page x:Class="teethWo.Pages.CartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:teethWo.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CartPage">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="6*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Корзина" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <ListView Name="CartList" Grid.Row="1" Background="#E4EFFA" Margin="10" Width="550">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="{Binding Product.name}" Margin="20, 10" Width="300"/>
                        <TextBlock Grid.Column="1" Text="{Binding Size}" Margin="20, 10"/>
                        <TextBlock Grid.Column="2" Text="{Binding Quantity}" Margin="20, 10"/>
                        <TextBlock Grid.Column="3" Text="{Binding Sum}" Margin="20, 10"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Удалить выбранное" Width="160" Height="30" Margin="5" Click="DelBtn_Click"/>
            <Button Content="Оформить заказ" Width="160" Height="30" Margin="5" Click="OrderBtn_Click"/>
            <Button Content="Назад" Width="160" Height="30" Margin="5" Click="BackBtn_Click"/>
        </StackPanel>
    </Grid>
</Page>
