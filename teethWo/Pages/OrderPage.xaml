<Page x:Class="teethWo.Pages.OrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:teethWo.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="OrderPage">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="6*"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <TextBox Name="SearchBox" HorizontalAlignment="Left" TextWrapping="Wrap" VerticalAlignment="Center" Width="205" TextChanged="TextBox_TextChanged" Margin="356,0,0,0"/>


        <DataGrid Name="OrderList" Grid.Row="1" Margin="5" Background="Transparent" AutoGenerateColumns="False" HorizontalAlignment="Center" BeginningEdit="OrderList_BeginningEdit" CellEditEnding="OrderList_CellEditEnding">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Номер заказа" Binding="{Binding orderNum}"/>
                <DataGridComboBoxColumn x:Name="UserColumn"
                    Header="Пользователь"
                    SelectedValueBinding="{Binding idUser, UpdateSourceTrigger=PropertyChanged}"
                    SelectedValuePath="id"
                    DisplayMemberPath="login" />
                <DataGridTextColumn Header="Дата заказа" Binding="{Binding orderDate}"/>
                <DataGridTextColumn Header="Количество" Binding="{Binding amount}"/>

            </DataGrid.Columns>
        </DataGrid>
        <TextBlock HorizontalAlignment="Left" Margin="239,0,0,0" TextWrapping="Wrap" Text="Логин пользователя:" VerticalAlignment="Center" Width="117"/>


    </Grid>
</Page>
