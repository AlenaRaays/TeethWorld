<Page x:Class="teethWo.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:teethWo.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AdminPage">

    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="10" Background="#E4EFFA">
            <Button Content="Товары"      Height="30" Margin="5" Click="ProductsBtn_Click"/>
            <Button Content="Категории"   Height="30" Margin="5" Click="CategoriesBtn_Click"/>
            <Button Content="Производители" Height="30" Margin="5" Click="ManufacturesBtn_Click"/>
            <Button Content="Размеры"     Height="30" Margin="5" Click="SizesBtn_Click"/>
            <Button Content="Склад"       Height="30" Margin="5" Click="WarehouseBtn_Click"/>
            <Button Content="Заказы"      Height="30" Margin="5" Click="OrdersBtn_Click"/>
            <Button Content="Пользователи" Height="30" Margin="5" Click="UsersBtn_Click"/>
            <Button Content="Назад"       Height="30" Margin="5,20,5,5" Click="BackBtn_Click"/>
        </StackPanel>

        <Frame Name="AdminFrame" Grid.Column="1" NavigationUIVisibility="Hidden"/>
    </Grid>
</Page>
