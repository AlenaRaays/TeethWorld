<Page x:Class="teethWo.Pages.AdminTablePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:teethWo.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AdminTablePage">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="6*"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <TextBlock Name="TitleTxt" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <DataGrid Name="Table" Grid.Row="1" AutoGenerateColumns="True" Margin="5" Background="#E4EFFA"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Сохранить" Width="150" Height="30" Margin="5" Click="SaveBtn_Click"/>
            <Button Name="DelBtn" Content="Удалить выбранное" Width="150" Height="30" Margin="5" Click="DelBtn_Click"/>
        </StackPanel>
    </Grid>
</Page>
