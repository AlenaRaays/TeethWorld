<Page x:Class="teethWo.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:teethWo.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProfilePage">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="6*"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <TextBlock Text="Личный кабинет" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <Grid Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="35"/>
                <RowDefinition Height="35"/>
                <RowDefinition Height="35"/>
                <RowDefinition Height="35"/>
                <RowDefinition Height="35"/>
                <RowDefinition Height="35"/>
                <RowDefinition Height="35"/>
            </Grid.RowDefinitions>

            <Label Content="Фамилия" Grid.Row="0" Grid.Column="0" Margin="0,5,10,0" HorizontalAlignment="Right"/>
            <TextBox Name="firNameTxt" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="5,5,0,0"/>

            <Label Content="Имя" Grid.Row="1" Grid.Column="0" Margin="0,5,10,0" HorizontalAlignment="Right"/>
            <TextBox Name="nameTxt" Grid.Row="1" Grid.Column="1" Margin="5,5,0,0" Grid.ColumnSpan="2"/>

            <Label Content="Отчество" Grid.Row="2" Grid.Column="0" Margin="0,5,10,0" HorizontalAlignment="Right"/>
            <TextBox Name="lastNameTxt" Grid.Row="2" Grid.Column="1" Margin="5,5,0,0" Grid.ColumnSpan="2"/>

            <Label Content="Логин" Grid.Row="3" Grid.Column="0" Margin="0,5,10,0" HorizontalAlignment="Right"/>
            <TextBox Name="loginTxt" Grid.Row="3" Grid.Column="1" Margin="5,5,0,0" Grid.ColumnSpan="2"/>

            <Label Content="Email" Grid.Row="4" Grid.Column="0" Margin="0,5,10,0" HorizontalAlignment="Right"/>
            <TextBox Name="emailTxt" Grid.Row="4" Grid.Column="1" Margin="5,5,0,0" Grid.ColumnSpan="2"/>

            <Label Content="Телефон" Grid.Row="5" Grid.Column="0" Margin="0,5,10,0" HorizontalAlignment="Right"/>
            <TextBox Name="phoneTxt" Grid.Row="5" Grid.Column="1" Margin="5,5,0,0" Grid.ColumnSpan="2"/>

            <Label Content="Пароль" Grid.Row="6" Grid.Column="0" Margin="0,5,10,0" HorizontalAlignment="Right"/>
            <TextBox Name="passTxt" Grid.Row="6" Grid.Column="1" Margin="5,5,0,0" Grid.ColumnSpan="2"/>

            <Label Content="Роль" Grid.Row="7" Grid.Column="0" Margin="0,5,10,0" HorizontalAlignment="Right"/>
            <TextBlock Name="roleTxt" Grid.Row="7" Grid.Column="1" VerticalAlignment="Center" Margin="5,0,0,0" Height="25"/>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" >
            <Button Content="Сохранить" Width="150" Height="30" Margin="5" Click="SaveBtn_Click"/>
            <Button Content="Назад" Width="150" Height="30" Margin="5" Click="BackBtn_Click"/>
        </StackPanel>
    </Grid>
</Page>
