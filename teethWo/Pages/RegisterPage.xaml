<Page x:Class="teethWo.Pages.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:teethWo.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RegisterPage">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="5*"/>
        </Grid.RowDefinitions>
        <Image Source="/Images/stomotology.png" Grid.Row="0"/>

        <Grid Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,20,0,0" Height="293">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>

            <Label Content="Фамилия" Grid.Row="0" Grid.Column="0" Margin="0,5,10,0" HorizontalAlignment="Left"/>
            <TextBox Name="firNameTxt" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="5,5,0,0"/>

            <Label Content="Имя" Grid.Row="1" Grid.Column="0" Margin="0,5,10,0" HorizontalAlignment="Left"/>
            <TextBox Name="nameTxt" Grid.Row="1" Grid.Column="1" Margin="5,5,0,0" Grid.ColumnSpan="2"/>

            <Label Content="Отчество" Grid.Row="2" Grid.Column="0" Margin="0,5,10,0" HorizontalAlignment="Left"/>
            <TextBox Name="lastNameTxt" Grid.Row="2" Grid.Column="1" Margin="5,5,0,0" Grid.ColumnSpan="2"/>

            <Label Content="Логин" Grid.Row="3" Grid.Column="0" Margin="0,5,10,0" HorizontalAlignment="Left"/>
            <TextBox Name="loginTxt" Grid.Row="3" Grid.Column="1" Margin="5,5,0,0" Grid.ColumnSpan="2"/>

            <Label Content="Email" Grid.Row="4" Grid.Column="0" Margin="0,5,10,0" HorizontalAlignment="Left"/>
            <TextBox Name="emailTxt" Grid.Row="4" Grid.Column="1" Margin="5,5,0,0" Grid.ColumnSpan="2"/>

            <Label Content="Телефон" Grid.Row="5" Grid.Column="0" Margin="0,5,10,0" HorizontalAlignment="Left"/>
            <TextBox Name="phoneTxt" Grid.Row="5" Grid.Column="1" Margin="5,5,0,0" Grid.ColumnSpan="2"/>

            <Label Content="Пароль" Grid.Row="6" Grid.Column="0" Margin="0,5,10,0" HorizontalAlignment="Left"/>
            <PasswordBox Name="passTxt" Grid.Row="6" Grid.Column="1" Margin="5,5,0,0" Grid.ColumnSpan="2"/>

            <Button Name="RegBtn" Content="Зарегистрироваться" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
            HorizontalAlignment="Left" Width="310" Click="RegBtn_Click" Margin="0,40,0,0" Grid.RowSpan="2"/>
        </Grid>
    </Grid>
</Page>
