<Page x:Class="teethWo.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:teethWo.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="LoginPage">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="4*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Image Source="/Images/stomotology.png"/>
        </Grid>

        <Grid Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,35,0,0">
            <TextBox Name="logintxt" HorizontalAlignment="Center" Margin="0,41,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="160"/>
            <Label Content="login" HorizontalAlignment="Left" Margin="0,10,0,0" VerticalAlignment="Top" Foreground="#2F6DB5" FontWeight="Medium"/>
            <Button Name="loginBtn" Content="Войти" HorizontalAlignment="Center" Margin="0,78,0,0" VerticalAlignment="Top" Height="22" Width="160" Click="loginBtn_Click"/>
            <Button Name="RegBtn" Content="Регистрация" HorizontalAlignment="Center" Margin="0,110,0,0" VerticalAlignment="Top" Height="22" Width="160" Click="RegBtn_Click"/>
        </Grid>
    </Grid>
</Page>
