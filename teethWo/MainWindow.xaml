<Window x:Class="teethWo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:teethWo"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="8*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#E4EFFA">
            <TextBlock Text="TeethWorld" VerticalAlignment="Center" Margin="10" FontSize="20" FontWeight="Bold" Foreground="#2F6DB5"/>
            <Button Content="Назад" HorizontalAlignment="Right" VerticalAlignment="Center" Height="30" Width="75" Click="Button_Click" Margin="15, 0"/>

        </Grid>

        <Grid Grid.Row="1">
            <Frame Name="FrameMain" NavigationUIVisibility="Hidden"/>
        </Grid>
    </Grid>
</Window>
